{
  "openapi": "3.0.3",
  "info": {
    "title": "Manual Precipitation Stations",
    "description": "This API provides access to the data generated by MeteoSwiss's manual precipitation monitoring network, which operates around 240 locations collecting daily rainfall and snow measurements. Users can retrieve data using REST API endpoints for automated downloads or access via the Open Data Explorer for manual selection.",
    "version": "1.0.0",
    "contact": {
      "name": "MeteoSwiss",
      "url": "https://opendatadocs.meteoswiss.ch"
    },
    "license": {
      "name": "Open Data",
      "url": "https://opendatadocs.meteoswiss.ch"
    },
    "termsOfService": "https://opendatadocs.meteoswiss.ch"
  },
  "servers": [
    {
      "url": "https://data.geo.admin.ch/api/stac/v1",
      "description": "FSDI REST API Server"
    }
  ],
  "paths": {
    "/collections/ch.meteoschweiz.ogd-nime": {
      "get": {
        "summary": "Get Manual Precipitation Stations Collection",
        "description": "Retrieve the STAC collection for manual precipitation stations data. This collection contains precipitation measurement data from MeteoSwiss's manual monitoring network of around 240 locations.",
        "operationId": "getManualPrecipitationCollection",
        "tags": [
          "Collections"
        ],
        "responses": {
          "200": {
            "description": "Successful response with collection metadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Collection"
                }
              }
            }
          },
          "404": {
            "description": "Collection not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/collections/ch.meteoschweiz.ogd-nime/items": {
      "get": {
        "summary": "Get Manual Precipitation Station Data Items",
        "description": "Retrieve data items (files) for manual precipitation stations. Data is split by measuring station and includes daily, monthly, and yearly values with recent and historical update frequencies.",
        "operationId": "getManualPrecipitationItems",
        "tags": [
          "Items"
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of items to return",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 10,
              "minimum": 1,
              "maximum": 1000
            }
          },
          {
            "name": "bbox",
            "in": "query",
            "description": "Bounding box to filter items by location (minLon,minLat,maxLon,maxLat)",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 4,
              "maxItems": 4
            },
            "style": "form",
            "explode": false
          },
          {
            "name": "datetime",
            "in": "query",
            "description": "Filter items by datetime range (ISO 8601 format)",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with data items",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItemCollection"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid parameters"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/collections/ch.meteoschweiz.ogd-nime/items/{itemId}": {
      "get": {
        "summary": "Get Specific Manual Precipitation Station Data Item",
        "description": "Retrieve a specific data file for a manual precipitation station. Files are named with station identifier, data granularity (d/m/y), and update frequency (recent/historical).",
        "operationId": "getManualPrecipitationItem",
        "tags": [
          "Items"
        ],
        "parameters": [
          {
            "name": "itemId",
            "in": "path",
            "description": "Identifier of the specific data item (e.g., station file identifier)",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with specific data item",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Item"
                }
              }
            }
          },
          "404": {
            "description": "Item not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Collection": {
        "type": "object",
        "description": "STAC Collection for manual precipitation stations",
        "properties": {
          "id": {
            "type": "string",
            "example": "ch.meteoschweiz.ogd-nime"
          },
          "type": {
            "type": "string",
            "example": "Collection"
          },
          "title": {
            "type": "string",
            "example": "Manual Precipitation Stations"
          },
          "description": {
            "type": "string",
            "example": "Manual precipitation monitoring network data from MeteoSwiss"
          },
          "stac_version": {
            "type": "string",
            "example": "1.0.0"
          },
          "license": {
            "type": "string",
            "example": "proprietary"
          },
          "extent": {
            "type": "object",
            "properties": {
              "spatial": {
                "type": "object",
                "properties": {
                  "bbox": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      }
                    }
                  }
                }
              },
              "temporal": {
                "type": "object",
                "properties": {
                  "interval": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "nullable": true
                      }
                    }
                  }
                }
              }
            }
          },
          "links": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Link"
            }
          }
        }
      },
      "ItemCollection": {
        "type": "object",
        "description": "Collection of STAC Items representing precipitation station data files",
        "properties": {
          "type": {
            "type": "string",
            "example": "FeatureCollection"
          },
          "features": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Item"
            }
          },
          "links": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Link"
            }
          },
          "numberMatched": {
            "type": "integer"
          },
          "numberReturned": {
            "type": "integer"
          }
        }
      },
      "Item": {
        "type": "object",
        "description": "STAC Item representing a precipitation station data file",
        "properties": {
          "id": {
            "type": "string",
            "example": "ogd-nime-aig_d_recent"
          },
          "type": {
            "type": "string",
            "example": "Feature"
          },
          "stac_version": {
            "type": "string",
            "example": "1.0.0"
          },
          "geometry": {
            "type": "object",
            "description": "GeoJSON geometry of the station location",
            "properties": {
              "type": {
                "type": "string",
                "example": "Point"
              },
              "coordinates": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 3
              }
            }
          },
          "properties": {
            "type": "object",
            "properties": {
              "datetime": {
                "type": "string",
                "format": "date-time",
                "nullable": true
              },
              "start_datetime": {
                "type": "string",
                "format": "date-time"
              },
              "end_datetime": {
                "type": "string",
                "format": "date-time"
              },
              "station_id": {
                "type": "string",
                "description": "Three-letter station identifier",
                "example": "AIG"
              },
              "station_name": {
                "type": "string",
                "example": "Aigle"
              },
              "data_granularity": {
                "type": "string",
                "enum": [
                  "d",
                  "m",
                  "y"
                ],
                "description": "Data granularity: d (daily), m (monthly), y (yearly)"
              },
              "update_frequency": {
                "type": "string",
                "enum": [
                  "recent",
                  "historical"
                ],
                "description": "Update frequency of the data file"
              }
            }
          },
          "assets": {
            "type": "object",
            "description": "Assets associated with this item (e.g., CSV data file)",
            "additionalProperties": {
              "$ref": "#/components/schemas/Asset"
            }
          },
          "links": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Link"
            }
          }
        }
      },
      "Asset": {
        "type": "object",
        "description": "Asset representing a downloadable data file",
        "properties": {
          "href": {
            "type": "string",
            "format": "uri",
            "description": "URL to download the asset"
          },
          "type": {
            "type": "string",
            "example": "text/csv",
            "description": "Media type of the asset"
          },
          "title": {
            "type": "string",
            "description": "Title of the asset"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "data"
            ]
          }
        }
      },
      "Link": {
        "type": "object",
        "description": "Link to related resources",
        "properties": {
          "href": {
            "type": "string",
            "format": "uri"
          },
          "rel": {
            "type": "string",
            "example": "self"
          },
          "type": {
            "type": "string",
            "example": "application/json"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "href",
          "rel"
        ]
      }
    }
  },
  "tags": [
    {
      "name": "Collections",
      "description": "Operations related to STAC collections"
    },
    {
      "name": "Items",
      "description": "Operations related to STAC items (data files)"
    }
  ],
  "externalDocs": {
    "description": "Manual Precipitation Stations Documentation",
    "url": "https://opendatadocs.meteoswiss.ch/a-data-groundbased/a5-manual-precipitation-stations"
  }
}
