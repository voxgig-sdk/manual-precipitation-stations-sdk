ormat\":\"date-time\",\"type\":\"string\"},\"start_datetime\":{\"format\":\"date-time\",\"type\":\"string\"},\"station_id\":{\"description\":\"Three-letter station identifier\",\"example\":\"AIG\",\"type\":\"string\"},\"station_name\":{\"example\":\"Aigle\",\"type\":\"string\"},\"update_frequency\":{\"description\":\"Update frequency of the data file\",\"enum\":[\"recent\",\"historical\"],\"type\":\"string\"}},\"type\":\"object\"},\"stac_version\":{\"example\":\"1.0.0\",\"type\":\"string\"},\"type\":{\"example\":\"Feature\",\"type\":\"string\"}},\"type\":\"object\"}}},\"description\":\"Successful response with specific data item\"},\"404\":{\"description\":\"Item not found\"},\"500\":{\"description\":\"Internal server error\"}},\"securitySource\":\"unspecified\"}"
